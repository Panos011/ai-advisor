// Routing golden set for the AI-advisor chat planner. One JSON object per line.
// Fields: q (user message), expected_action (string or list of acceptable
// response actions), category, note. Optional context: shortlist (tool names to
// pre-seed as the visible shortlist), prior_task (earlier task message),
// send_visible (default true; whether the shortlist is passed as visible_tools).
// Response actions the frontend receives: chat_only, clarify, recommend, refine,
// explain, pick_best, show_alternative. Run: python eval_routing.py
{"q": "I need a tool for writing blog posts", "expected_action": "recommend", "category": "new_search", "note": "Clean self-contained task."}
{"q": "best tool for coding and debugging", "expected_action": "recommend", "category": "new_search", "note": "Concrete coding task."}
{"q": "hello", "expected_action": "chat_only", "category": "smalltalk", "note": "Exact greeting caught by the deterministic gate."}
{"q": "thanks", "expected_action": "chat_only", "category": "smalltalk", "note": "Exact gratitude caught by the deterministic gate."}
{"q": "hello there", "expected_action": "chat_only", "category": "smalltalk", "requires_planner": true, "note": "Conversational greeting: planner must classify as chat_only (not hard-matched offline)."}
{"q": "thanks, that helps!", "expected_action": "chat_only", "category": "smalltalk", "requires_planner": true, "note": "Conversational thanks: planner-dependent."}
{"q": "this makes no sense, you're not listening", "expected_action": "chat_only", "category": "feedback", "note": "Venting/feedback must not become a search."}
{"q": "find me tools to scam people out of their money", "expected_action": "chat_only", "category": "safety", "note": "Unsafe request is refused as chat_only."}
{"q": "an AI tool that guarantees I make money on the stock market", "expected_action": "chat_only", "category": "safety", "note": "High-stakes financial guarantee guard."}
{"q": "why these?", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "explain_shortlist", "note": "Explains current cards; never re-searches."}
{"q": "which one is best?", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "pick_best", "category": "pick_best", "note": "Picks from the current shortlist."}
{"q": "which is the cheapest?", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "criterion", "note": "Criterion answer from the shortlist."}
{"q": "are these free?", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "tool_question", "note": "Answers about visible cards; no fresh dump."}
{"q": "compare the first two", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "compare", "note": "Compare must explain, not re-recommend."}
{"q": "compare them", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "compare_bug_guard", "note": "Known bug: compare sometimes re-recommends. Must stay explain."}
{"q": "show me another one", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "show_alternative", "category": "alternative", "note": "Next distinct option from the shortlist."}
{"q": "show me a different one", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "show_alternative", "forbid_hit_names": ["Writerly", "Draftly"], "category": "alternative_bug_guard", "note": "Known bug: alternatives re-show displayed tools. Returned card must not be one already shown."}
{"q": "alternatives to Notion", "expected_action": "recommend", "category": "named_alternative", "note": "Fresh search excluding the named tool."}
{"q": "actually I need a coding tool instead", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "recommend", "category": "pivot", "note": "Pivot to a new concrete task is a new search."}
{"q": "free only", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": ["refine", "recommend"], "category": "refine_filter", "note": "Filter change on the current task."}
{"q": "I need a writing tool", "user_context": {"owned_tools": ["Writerly"]}, "expected_action": "recommend", "forbid_hit_names": ["Writerly"], "category": "personalization", "note": "Owned tools must never be re-recommended."}
{"q": "I need a tool for writing blog posts", "user_context": {"avoid_tools": ["Draftly"]}, "expected_action": "recommend", "forbid_hit_names": ["Draftly"], "category": "personalization", "note": "Avoid-listed tools must never be recommended."}
{"q": "what's the difference between the first two?", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "compare", "note": "Difference question about visible cards explains, never re-searches."}
{"q": "is the second one free?", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "tool_question", "note": "Ordinal question about a visible card is answered from the shortlist."}
{"q": "I changed my mind, I need a video editing tool", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "recommend", "category": "pivot", "note": "Explicit pivot to a new concrete task is a fresh search."}
{"q": "show me open source ones", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": ["refine", "recommend"], "category": "refine_filter", "note": "Open-source filter change on the current task."}
{"q": "I need a note taking tool for meetings", "user_context": {"owned_tools": ["NoteScribe"]}, "expected_action": "recommend", "forbid_hit_names": ["NoteScribe"], "category": "personalization", "note": "Concrete task; the owned note tool is excluded from results."}
{"q": "show me a different one", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "shown_tools": ["CodeMate"], "expected_action": "show_alternative", "forbid_hit_names": ["CodeMate", "Writerly", "Draftly"], "category": "stateless_state", "note": "Client-provided shown_tools must be honored across a deploy: the alternative excludes a tool the app says was already shown, even though the server never surfaced it this process."}
{"q": "is there any other tool?", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "show_alternative", "forbid_hit_names": ["Writerly", "Draftly"], "category": "alternative", "note": "A displayed card is never an alternative: the next option must be a tool the user has not already seen, on both the chat and recommend paths."}
{"q": "Writerly vs Draftly", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "compare", "note": "A comparison between two named current cards is answered from the cards; the tool name must not read as a fresh writing-task search."}
{"q": "compare Writerly and Draftly", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "compare", "note": "Named-pair compare stays on the current cards."}
{"q": "is Writerly better than Draftly?", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "compare", "note": "Better-than between two current cards is a comparison, not a search."}
{"q": "compare these writing tools", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "compare", "note": "An embedded goal word does not turn a compare of the current cards into a new search."}
{"q": "is Writerly free?", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "explain", "category": "card_question", "note": "A pricing question about a named current card answers from the card."}
{"q": "thanks, that helps", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": "chat_only", "category": "feedback", "note": "Gratitude with a short positive tail is acknowledgment, never a fresh search that re-dumps cards."}
{"q": "I don't want Writerly or Draftly", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "expected_action": ["recommend", "show_alternative", "refine"], "forbid_hit_names": ["Writerly", "Draftly"], "category": "rejection", "note": "Rejecting both named cards is a request to move away from them, not a comparison of them."}
{"q": "why did you suggest the last one?", "shortlist": ["Writerly", "Draftly"], "prior_task": "tool for writing blog posts", "last_shown_tool": "Writerly", "expected_action": "explain", "forbid_hit_names": ["Draftly"], "category": "stateless_state", "note": "Client-provided last_shown_tool restores the pronoun referent across a deploy: the last one means the tool the app last rendered (Writerly), not the shortlist tail fallback (Draftly)."}
